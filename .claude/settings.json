{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/translate-claude-md.sh",
            "shell": "bash",
            "timeout": 120,
            "statusMessage": "CLAUDE-ko.md 갱신 중..."
          }
        ]
      }
    ]
  }
}
